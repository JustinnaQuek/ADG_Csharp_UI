<Window x:Class="SmuMultichannelUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multichannel SMU" Height="620" Width="1100" Background="#FF1E1E1E">

    <Window.Resources>
        <SolidColorBrush x:Key="GraphBg" Color="#FF262626" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#FF3F3F3F" />
        <SolidColorBrush x:Key="AxisTextBrush" Color="#FFB0B0B0" />
        <SolidColorBrush x:Key="ToolbarBg" Color="#FF2D2D2D" />
        <SolidColorBrush x:Key="SidebarBg" Color="#FFF7F9FC" />
        <SolidColorBrush x:Key="SidebarBorder" Color="#FFE0E4EA" />
        <SolidColorBrush x:Key="HeaderBlue" Color="#FF1F6FD1" />
        <SolidColorBrush x:Key="TitleNavy" Color="#FF1B2A4A" />
        <SolidColorBrush x:Key="LabelGray" Color="#FF7A7F87" />
        <SolidColorBrush x:Key="FieldBorder" Color="#FFC9CDD3" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelGray}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderBlue}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OutputToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="10" Background="#FFC9CDD3" />
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource HeaderBlue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutputLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelGray}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ============ LEFT: graph + measurement table ============ -->
        <Grid Grid.Column="0" Background="#FF1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Layout toolbar -->
            <Border Grid.Row="0" Background="{StaticResource ToolbarBg}" Padding="10,6">
                <TextBlock Text="Layout:  ▦  ▥  ▤  ▧" Foreground="{StaticResource AxisTextBrush}" FontSize="12" />
            </Border>

            <!-- Graph -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource ToolbarBg}" Padding="10,4">
                    <TextBlock Text="TimeDomainGraph  ▾" Foreground="{StaticResource HeaderBlue}" FontSize="12" FontWeight="SemiBold" />
                </Border>

                <Border Grid.Row="1" Background="{StaticResource GraphBg}" Margin="0,1,0,0">
                    <Grid x:Name="GraphHost" SizeChanged="GraphHost_SizeChanged">
                        <Canvas x:Name="GraphCanvas" ClipToBounds="True" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource GraphBg}" Padding="10,4">
                    <StackPanel x:Name="LegendPanel" Orientation="Horizontal" />
                </Border>
            </Grid>

            <!-- Measurement table toolbar (light mode) -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,0,1" Padding="10,4" Margin="0,1,0,0">
                <TextBlock Text="MeasurementTable  ▾" Foreground="{StaticResource HeaderBlue}" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <!-- Measurement table (light mode) -->
            <DataGrid x:Name="MeasurementGrid" Grid.Row="3" Margin="0,1,0,0"
                      Background="White" Foreground="{StaticResource TitleNavy}" RowBackground="White"
                      AlternatingRowBackground="#FFF3F5F8" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource SidebarBorder}"
                      HeadersVisibility="Column" AutoGenerateColumns="False" IsReadOnly="True"
                      ItemsSource="{Binding MeasurementRows}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SidebarBg}" />
                        <Setter Property="Foreground" Value="{StaticResource LabelGray}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="BorderBrush" Value="{StaticResource SidebarBorder}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="90" />
                    <DataGridTextColumn Header="Measurement" Binding="{Binding Measurement}" Width="100" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat={}{0:0.000}}" Width="90" />
                    <DataGridTextColumn Header="Mean" Binding="{Binding Mean, StringFormat={}{0:0.000}}" Width="90" />
                    <DataGridTextColumn Header="Minimum" Binding="{Binding Minimum, StringFormat={}{0:0.000}}" Width="90" />
                    <DataGridTextColumn Header="Maximum" Binding="{Binding Maximum, StringFormat={}{0:0.000}}" Width="90" />
                    <DataGridTextColumn Header="Statistical range" Binding="{Binding StatisticalRange, StringFormat={}{0:0.000}}" Width="120" />
                    <DataGridTextColumn Header="Std. deviation" Binding="{Binding StdDeviation, StringFormat={}{0:0.000}}" Width="110" />
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ============ RIGHT: sidebar ============ -->
        <Border Grid.Column="1" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,16,16,16">

                    <TextBlock Text="Multichannel SMU" Style="{StaticResource SectionHeader}" FontSize="20" Foreground="{StaticResource TitleNavy}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Idle" Foreground="{StaticResource LabelGray}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="StartButton" Content="RUN" Width="90" Height="28" Margin="0,0,8,0" Click="StartButton_Click" />
                        <Button x:Name="StopButton" Content="STOP" Width="90" Height="28" Click="StopButton_Click" IsEnabled="False" />
                    </StackPanel>

                    <TextBlock Text="▼ Channels" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />
                    <StackPanel x:Name="ChannelTogglePanel" Margin="0,0,0,16" />

                    <TextBlock Text="▼ Configuration" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />
                    <ItemsControl x:Name="ChannelsItemsControl" ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,0,1" Padding="0,8,0,10" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ChannelName}" FontWeight="Bold" Foreground="{StaticResource TitleNavy}" Margin="0,0,0,6" />

                                        <TextBlock Text="SET VOLTAGE (V)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Tag="{Binding}" Text="{Binding SetVoltage, Mode=OneWay}"
                                                 LostFocus="SetVoltageTextBox_LostFocus" Style="{StaticResource FieldBox}" />

                                        <TextBlock Text="COMPLIANCE CURRENT LIMIT (A)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Tag="{Binding}" Text="{Binding ComplianceCurrentLimit, Mode=OneWay}"
                                                 LostFocus="ComplianceLimitTextBox_LostFocus" Style="{StaticResource FieldBox}" />

                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource LabelGray}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
